# --- Rust ------------------------------------------------------------------
/target
**/*.rs.bk
*.pdb

# --- Flutter / Dart (apps/client, added once the SDK is available) ----------
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# The UI fonts (~20 MB of Noto Sans CJK). `pubspec.yaml` declares them, so a
# build without them fails; `scripts/fetch-fonts.sh` puts them there. They are
# not committed because they are large, immutable, and one HTTP request away —
# see that script's header and `docs/UI字体规范.md`.
apps/client/assets/fonts/

# --- IDE -------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.code-workspace

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Local runtime state ---------------------------------------------------
# Never commit identities, logs or captured server lists.
*.identity
/run/
/logs/
/dist/
__pycache__/

# --- Debugging leftovers ---------------------------------------------------
# Where the browser-automation tool drops its page snapshots and console logs
# when driving the gateway's debug page. Artifacts of a session, not of the
# repository — and one of them per tool call.
.playwright-mcp/
# Screenshots taken at the repository root during a smoke test.
/*.png

# Flutter DevTools writes this into the project; it is tool state, not ours.
devtools_options.yaml
