-/// Whether we may open a connection to `ip`. We run server-side on behalf of
-/// arbitrary browser users, so by default only public addresses are fair game -
-/// anything else would let a user (or a server/DNS record they control) point
-/// us into the host's own network. Self-hosters whose TeamSpeak server lives
-/// on the same LAN opt in with `ALLOW_PRIVATE_TARGETS=1`.
+/// Whether we may open a connection to `ip`.
+///
+/// **Changed for Nightcord Speak.** Upstream allows only public addresses,
+/// because WebSpeak3 runs server-side on behalf of arbitrary browser users and
+/// a private address there is an SSRF attempt. Nightcord Speak is a native
+/// client: the person at the keyboard chose the address, and a server on their
+/// own LAN is the ordinary case. So the default is inverted — private targets
+/// are allowed, and `BLOCK_PRIVATE_TARGETS=1` restores the upstream behaviour.
+///
+/// The file-transfer guard in `lib.rs` calls `is_public_addr` directly and is
+/// deliberately unaffected by this. A redirect to an internal address that the
+/// *server* reported is still rejected unless the voice peer we are already
+/// connected to is itself internal, which is exactly the case that guard
+/// exists for.
 pub fn is_allowed_target(ip: &IpAddr) -> bool {
-	std::env::var("ALLOW_PRIVATE_TARGETS").is_ok_and(|v| v == "1") || is_public_addr(ip)
+	let strict = std::env::var("BLOCK_PRIVATE_TARGETS").is_ok_and(|v| v == "1");
+	!strict || is_public_addr(ip)
 }
 
 #[derive(Debug, PartialEq, Eq)]
