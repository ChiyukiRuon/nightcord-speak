+/// What the library should do when an established connection drops.
+///
+/// The default matches upstream behaviour, so this is additive. `External` exists so an
+/// application that owns its own reconnect policy — with its own schedule, attempt counter and
+/// user-visible state — can keep **exactly one** backoff in play. Two of them fighting over the
+/// same connection is worse than either alone.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ReconnectMode {
+	/// Reconnect inside the library, waiting a fixed ten seconds between attempts.
+	///
+	/// This is upstream's behaviour and the default.
+	#[default]
+	Automatic,
+	/// Report the drop and end the event stream, leaving the decision to the caller.
+	///
+	/// The caller sees [`StreamItem::DisconnectedTemporarily`] and then the end of the stream,
+	/// which is everything it needs to rebuild the connection on its own terms — including a
+	/// different delay, or giving up after a budget of attempts.
+	External,
+}
