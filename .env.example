# 默认拉取已发布镜像；源码构建需要显式叠加 docker-compose.build.yaml，见 DEPLOY.md。
NIGHTCORD_GATEWAY_IMAGE=ghcr.io/chiyukiruon/nightcord-speak-gateway:latest

# 默认仅发布到宿主机回环地址；局域网部署可改成 0.0.0.0。
NIGHTCORD_GATEWAY_HOST=127.0.0.1
NIGHTCORD_GATEWAY_PORT=8787

# 多个网页来源用逗号分隔，不加空格；留空沿用网关的本机来源策略。
# 例如：https://speak.example.com,https://preview.example.com
NIGHTCORD_GATEWAY_ORIGINS=

# 非空时启用网关鉴权；同时在网页构建环境中设置相同的 Token。
NIGHTCORD_GATEWAY_TOKEN=

# 未指定身份档名的连接使用该档名；网页在设置里自选，已选定的设备不受影响。
NIGHTCORD_GATEWAY_PROFILE=web
NIGHTCORD_GATEWAY_LOG=info
NIGHTCORD_GATEWAY_TZ=Asia/Shanghai
